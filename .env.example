# -----------------------------------------------------------------------------
# Configure these as GitHub Codespace secrets, not as a committed .env file.
#   Repo: Settings -> Secrets and variables -> Codespaces -> New secret
#   User: https://github.com/settings/codespaces  (applies across repos)
#
# Codespaces injects secrets as real env vars at container start; the
# .devcontainer/devcontainer.json `remoteEnv` block forwards the ones below.
# -----------------------------------------------------------------------------

# ---- Option A: official Anthropic / OpenAI ----------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ---- Option B: third-party Anthropic-compatible provider (e.g. DeepSeek) ----
# Claude Code reads ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN and routes every
# request to that endpoint instead of api.anthropic.com. Model name env vars
# below let you map Opus/Sonnet/Haiku slots to whatever the provider offers.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=<your provider key>
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_CODE_EFFORT_LEVEL=max

# ---- Option C: route Claude Code through Bedrock / Vertex -------------------
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1
